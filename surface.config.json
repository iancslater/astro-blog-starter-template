{
  "version": "1.0.0",
  "engine": "git-backed",
  "workspace": {
    "contentRoot": ".",
    "extension": "md",
    "framework": "astro"
  },
  "schema": {
    "fields": [
      {
        "name": "title",
        "type": "string",
        "uiComponent": "text-input"
      },
      {
        "name": "description",
        "type": "string",
        "uiComponent": "textarea"
      },
      {
        "name": "pubDate",
        "type": "string",
        "uiComponent": "text-input"
      },
      {
        "name": "heroImage",
        "type": "image",
        "uiComponent": "image-picker"
      },
      {
        "name": "type",
        "type": "string",
        "uiComponent": "text-input"
      },
      {
        "name": "printSize",
        "type": "string",
        "uiComponent": "text-input"
      },
      {
        "name": "orientation",
        "type": "string",
        "uiComponent": "text-input"
      },
      {
        "name": "year",
        "type": "string",
        "uiComponent": "text-input"
      },
      {
        "items": "string",
        "name": "tags",
        "type": "array",
        "uiComponent": "tag-cloud"
      },
      {
        "name": "downloadFile",
        "type": "string",
        "uiComponent": "text-input"
      },
      {
        "name": "previewImage",
        "type": "image",
        "uiComponent": "image-picker"
      }
    ],
    "strictValidation": true
  },
  "regionalization": {
    "enabled": false
  },
  "contentLibrary": {
    "collections": [
      {
        "contentRoot": "src/content/blog",
        "extension": "md",
        "fields": [
          "title",
          "description",
          "pubDate",
          "heroImage"
        ],
        "id": "src-content-blog",
        "label": "Blog",
        "surfaces": [
          "draft"
        ]
      },
      {
        "contentRoot": "src/content/propaganda",
        "extension": "md",
        "fields": [
          "title",
          "type",
          "printSize",
          "orientation",
          "year",
          "tags",
          "downloadFile",
          "previewImage"
        ],
        "id": "src-content-propaganda",
        "label": "Propaganda",
        "surfaces": [
          "draft"
        ]
      }
    ]
  },
  "media": {
    "assetRoots": []
  }
}
